{
  "_comment": "Exploratory run against the real variant-2-pixel.psd, using its actual layer names (not yet mapped to MainWeapon/Special enum slots -- that mapping is ambiguous pending user confirmation, see chat). Output goes to contracts/RenderersV2Explore, a throwaway directory for visual review only, not wired into the game or ImageRendererV2.",
  "psdFile": "variant-2-pixel copy.psd",
  "canvasSize": 256,
  "outputDir": "contracts/RenderersV2Explore",
  "categories": {
    "fore": {
      "combinerContract": "RenderForeV2Explore",
      "leaves": [
        { "psdLayerName": "fore-0", "contractName": "RenderFore0V2Explore", "required": true },
        { "psdLayerName": "fore-1", "contractName": "RenderFore1V2Explore", "required": true },
        { "psdLayerName": "fore-3", "contractName": "RenderFore3V2Explore", "required": true },
